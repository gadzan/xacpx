{
  "record": [
    "logger.debug(command.parsed)",
    "sessions.getResolvedSessionByInternalAlias(\"demo\")",
    "sessions.resolveSession(\"demo\", \"codex\", \"backend\", \"backend:demo\")",
    "orchestration.reserveLogicalTransportSession(\"backend:demo\")",
    "transport.ensureSession(session(demo/backend:demo), fn)",
    "logger.error(transport.ensure_session.failed)",
    "reply(\"📦 Missing dependency `opencode-windows-…\")",
    "reply(\"🔄 Installation complete, verifying sess…\")",
    "transport.ensureSession(session(demo/backend:demo), fn)",
    "logger.info(transport.ensure_session.verify)",
    "transport.hasSession(session(demo/backend:demo))",
    "logger.info(transport.has_session)",
    "sessions.attachSession(\"demo\", \"codex\", \"backend\", \"backend:demo\")",
    "sessions.useSession(\"wx:user\", \"demo\")",
    "sessions.getSession(\"demo\")",
    "logger.info(session.created)",
    "logger.info(command.completed)"
  ],
  "outcome": {
    "ok": {
      "text": "Session \"demo\" created and switched."
    }
  }
