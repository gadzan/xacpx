{
  "record": [
    "sessions.tryReserveFreeSessionAlias(\"relay:demo\")",
    "sessions.resolveSession(\"relay:demo\", \"codex\", \"backend\", \"backend:relay:demo\", {…})",
    "orchestration.reserveLogicalTransportSession(\"backend:relay:demo\")",
    "transport.resumeAgentSession(session(relay:demo/backend:relay:demo), \"sess-1\")",
    "transport.hasSession(session(relay:demo/backend:relay:demo))",
    "logger.info(transport.has_session)",
    "sessions.attachNativeSession(session(relay:demo/backend:relay:demo))",
    "sessions.getSession(\"relay:demo\")"
  ],
  "outcome": {
    "ok": {
      "alias": "relay:demo",
      "agent": "codex",
      "driver": "codex",
      "agentCommand": "<runtime> <xacpx>/src/adapters/acp-output-guard-main.ts -- npx -y --registry=https://registry.npmjs.org --@agentclientprotocol:registry=https://registry.npmjs.org @agentclientprotocol/codex-acp@1.1.9",
      "acpxAgent": "xacpx-managed-<driver>-<hash>",
      "agentArgv": [
        "<runtime>",
        "<xacpx>/src/adapters/acp-output-guard-main.ts",
        "--",
        "npx",
        "-y",
        "--registry=https://registry.npmjs.org",
        "--@agentclientprotocol:registry=https://registry.npmjs.org",
        "@agentclientprotocol/codex-acp@1.1.9"
      ],
      "workspace": "backend",
      "transportSession": "backend:relay:demo",
