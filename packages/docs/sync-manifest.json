{
  "version": 1,
  "description": "Maps each docs source of truth to its VitePress site page(s). packages/docs is an editorially independent site (English-first, condensed, own link graph), NOT a byte copy of docs/ — so the gate records the source hash at last reconciliation and fails when a source changes without the site page being reviewed. Run `node ./scripts/sync-docs-site.mjs reconcile` after updating a site page (or to accept a no-impact delta).",
  "ignore": [
    "docs/agents/**",
    "docs/superpowers/**",
    "docs/design/**",
    "docs/research/**",
    "docs/zh/**"
  ],
  "siteOnly": [
    "index.md",
    "zh/index.md",
    "guide/relay-self-hosting.md",
    "zh/guide/relay-self-hosting.md"
  ],
